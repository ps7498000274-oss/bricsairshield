# ---------------------------------------------------------------------------
# BRICS AirShield — environment variables
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Google AI Studio key for Gemini (free tier).
# Create at https://aistudio.google.com/app/apikey
# Server-side only — this value is never exposed to the browser.
GEMINI_API_KEY=

# Optional fallback: when running inside Lovable, LOVABLE_API_KEY is injected
# automatically and proxies the same Google Gemini models. Leave blank locally.
LOVABLE_API_KEY=
